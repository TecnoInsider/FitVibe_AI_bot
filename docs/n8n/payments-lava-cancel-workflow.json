        "query": "SELECT tg_id, email, access_until, auto_renew, subscription_contract_id, contract_id FROM user_profiles WHERE ({{ $json.tg_id || -1 }} > 0 AND tg_id = {{ $json.tg_id || -1 }}) OR ({{ $json.email ? '\"1\"' : 'NULL' }} IS NOT NULL AND email = '{{ $json.email || '' }}') OR ({{ $json.contract_id ? '\"1\"' : 'NULL' }} IS NOT NULL AND (subscription_contract_id = '{{ $json.contract_id || '' }}' OR contract_id = '{{ $json.contract_id || '' }}')) ORDER BY updated_at DESC LIMIT 1;",
