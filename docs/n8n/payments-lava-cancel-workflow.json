        "jsCode": "const req = $('Code: prepare cancel').first().json;\nconst code = $json.statusCode || 500;\nconst body = $json.body || {};\nconst success = code >= 200 && code < 300 && body.success !== false;\nconst accessText = req.access_until ? new Date(req.access_until).toLocaleString('ru-RU', { hour12: false }) : 'конца текущего оплаченного периода';\nreturn [{ json: { ...req, success, status: success ? 'cancelled' : 'error', message: success ? `Автопродление отключено. Доступ сохранится до ${accessText}.` : (body.message || 'Не удалось отключить автопродление') } }];"
